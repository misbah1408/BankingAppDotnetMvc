<!doctype html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Apex Financial System</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-950 text-slate-100 min-h-screen">
    <nav class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex justify-between">
        <a class="font-bold text-xl" href="/">🏦 Apex Financial</a>
        <div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="mr-4 text-slate-400">@User.Identity.Name ·
                    @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                    <a class="text-red-400" href="/Account/Logout">Logout</a>
                }
            </div>
        </nav>
        <main class="max-w-7xl mx-auto p-6">
            @if (TempData["Success"] != null)
            {
                <div class="bg-emerald-900/50 border border-emerald-700 p-3 rounded mb-5">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="bg-red-900/50 border border-red-700 p-3 rounded mb-5">
                    @TempData["Error"]</div>
                }
                @RenderBody()
            </main>
        </body>

    </html>
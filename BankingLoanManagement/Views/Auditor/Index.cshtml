<h1 class="text-3xl font-bold mb-6">Auditor Dashboard</h1>



<div id="view-auditor" class="role-view space-y-6">
	<!-- Bank Stats -->
	<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
		<div class="bg-slate-800 p-4 rounded-xl border border-slate-700">
			<div class="text-xs text-slate-400 mb-1">Total System Liquidity</div>
			<div class="text-xl font-bold text-white">₹@ViewBag.Liquidity.ToString("N0")</div>
		</div>
		<div class="bg-slate-800 p-4 rounded-xl border border-slate-700">
			<div class="text-xs text-slate-400 mb-1">Deployed Loans Principal</div>
			<div class="text-xl font-bold text-amber-400">₹@ViewBag.Loans.ToString("N0")</div>
		</div>
		<div class="bg-slate-800 p-4 rounded-xl border border-slate-700">
			<div class="text-xs text-slate-400 mb-1">Total Reserve Accounts</div>
			<div class="text-xl font-bold text-emerald-400">@ViewBag.Accounts Accounts</div>
		</div>
		<div class="bg-slate-800 p-4 rounded-xl border border-slate-700">
			<div class="text-xs text-slate-400 mb-1">Transactions</div>
			<div class="text-xl font-bold text-red-400">@ViewBag.Transactions</div>
		</div>
	</div>

	<!-- Immutable Audit Trail -->
	<div class="bg-slate-800 p-6 rounded-2xl border border-slate-700">
		<h2 class="text-lg font-bold mb-4 flex items-center gap-2">
			<i class="fa-solid fa-shield-halved text-red-400"></i> Immutable Audit Log (`AuditLog`)
		</h2>
		<div class="overflow-x-auto">
			<table class="w-full text-left text-xs">
				<thead class="bg-slate-900 text-slate-400 border-b border-slate-700">
					<tr>
						<th class="p-3">Log ID</th>
						<th class="p-3">Timestamp</th>
						<th class="p-3">Performed By</th>
						<th class="p-3">Module</th>
						<th class="p-3">Action Details</th>
						<th class="p-3">Action</th>
						@* <th class="p-3">IP Address</th> *@
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-700/50">
					@foreach (var x in Model)
					{
						<tr>
							<td class="p-3 font-mono text-slate-400">@x.Id</td>
							<td class="p-3">@x.LogDate</td>
							<td class="p-3 font-semibold text-slate-200">@x.PerformedBy</td>
							<td class="p-3">@x.Role</td>
							<td class="p-3">@x.Details</td>
							<td class="p-3">
								<span class="px-2 py-0.5 rounded bg-blue-500/20 text-blue-400 font-semibold">@x.ActionPerformed</span>
							</td>
							@* <td class="p-3 font-mono text-slate-400">@x.IpAddress</td> *@
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
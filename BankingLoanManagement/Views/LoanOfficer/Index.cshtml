<div id="view-officer" class="role-view space-y-6">
    <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-bold flex items-center gap-2">
                <i class="fa-solid fa-scale-balanced text-amber-400"></i> Underwriting Queue (Pending Approvals)
            </h2>
            <span class="bg-amber-500/20 text-amber-400 text-xs px-3 py-1 rounded-full font-semibold">
                @Model.Count Pending Applications
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-900 text-slate-400 border-b border-slate-700">
                    <tr>
                        <th class="p-3">Applicant</th>
                        <th class="p-3">Category</th>
                        <th class="p-3">Amount</th>
                        <th class="p-3">Tenure</th>
                        <th class="p-3">Collateral Metrics</th>
                        <th class="p-3">Credit Risk</th>
                        <th class="p-3">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-700/50">
                    @foreach (var l in Model)
                    {
                        var rowClass = l.LoanType == LoanType.Gold
                                ? "bg-yellow-500/20 text-yellow-400"
                                : l.LoanType == LoanType.Home
                                ? "bg-blue-500/20 text-blue-400"
                                : l.LoanType == LoanType.Personal
                                ? "bg-purple-500/20 text-purple-400"
                                : "bg-green-500/20 text-green-400";
                        <tr>
                            <td class="p-3 font-semibold">@l.CustomerProfile.User.Name</td>
                            <td class="p-3">
                                <span class="px-2 py-0.5 rounded font-semibold @rowClass">@l.LoanType</span>
                            </td>
                            <td class="p-3 font-bold">₹@l.PrincipalAmount.ToString("N2")</td>
                            <td class="p-3 font-bold">@l.TenureMonths months</td>
                            <td class="p-3 text-slate-400">
                                @if(@l.CollateralDetails == null)
                                {
                                    var res = "no details available";
                                    @res
                                }
                                else
                                {
                                    @l.CollateralDetails
                                }
                            </td>
                            <td class="p-3">
                                <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-semibold">
                                    @l.CreditScore Score
                                </span>
                            </td>
                            <td class="p-3 flex gap-2">
                                <div class="mt-4 flex gap-2">
                                    <form method="post" action="/LoanOfficer/Approve">
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <input name="interestRate" value="10" type="number" step="0.01"
                                               class="w-24 p-2 bg-slate-800 rounded" />
                                        <button class="bg-emerald-600 px-3 py-2 rounded">Approve</button>
                                    </form>
                                    <form method="post" action="/LoanOfficer/Reject">
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <input name="reason" placeholder="Rejection reason"
                                               class="p-2 bg-slate-800 rounded" />
                                        <button class="bg-red-600 px-3 py-2 rounded">Reject</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model IEnumerable<BankingLoanManagement.Models.Transaction>

@{
    ViewData["Title"] = "Transaction Report";
}

<div class="mb-6">

    <a asp-action="Index"
       class="text-blue-400">
        ← Back to Reports
    </a>

    <h1 class="text-3xl font-bold mt-3">
        Transaction Report
    </h1>

</div>


<!-- FILTER -->

<div class="bg-slate-900 rounded-xl p-5 mb-6">

    <form method="get"
          asp-action="Transactions"
          class="grid grid-cols-1 md:grid-cols-4 gap-4">

        <div>
            <label class="text-sm text-slate-400">
                From
            </label>

            <input type="date"
                   name="from"
                   value="@ViewBag.From"
                   class="w-full mt-1 bg-slate-800
                          border border-slate-700
                          rounded-lg p-2" />
        </div>


        <div>
            <label class="text-sm text-slate-400">
                To
            </label>

            <input type="date"
                   name="to"
                   value="@ViewBag.To"
                   class="w-full mt-1 bg-slate-800
                          border border-slate-700
                          rounded-lg p-2" />
        </div>


        <div>
            <label class="text-sm text-slate-400">
                Type
            </label>

            <select name="type"
                    class="w-full mt-1 bg-slate-800
                           border border-slate-700
                           rounded-lg p-2">

                <option value="">
                    All
                </option>

                <option value="Deposit">
                    Deposits
                </option>

                <option value="Withdrawal">
                    Withdrawals
                </option>

                <option value="Transfer">
                    Transfers
                </option>

            </select>

        </div>


        <div class="flex items-end">

            <button type="submit"
                    class="w-full bg-blue-600
                           hover:bg-blue-500
                           rounded-lg p-2">

                Filter

            </button>

        </div>

    </form>

</div>


<!-- TABLE -->

<div class="bg-slate-900 rounded-xl p-5 overflow-x-auto">

    <table class="w-full">

        <thead>

            <tr class="text-left text-slate-400">

                <th class="pb-3">
                    ID
                </th>

                <th>
                    Type
                </th>

                <th>
                    Amount
                </th>

                <th>
                    Date
                </th>

            </tr>

        </thead>

        <tbody>

        @foreach (var transaction in Model)
        {
            <tr class="border-t border-slate-800">

                <td class="py-3">
                    @transaction.Id
                </td>

                <td>
                    @transaction.Type
                </td>

                <td>
                    ₹@transaction.Amount.ToString("N2")
                </td>

                <td>
                    @transaction.TransactionDate.ToString("dd-MM-yyyy HH:mm")
                </td>

            </tr>
        }

        </tbody>

    </table>

</div>
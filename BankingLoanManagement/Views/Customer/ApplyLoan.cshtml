@model BankingLoanManagement.ViewModels.LoanVm;

<div class="max-w-2xl mx-auto bg-slate-900 p-7 rounded-xl">
    <h1 class="text-2xl font-bold mb-5">Apply for Loan</h1>
    <form method="post" enctype="multipart/form-data" class="space-y-4">
        <select asp-for="LoanType" class="w-full p-3 bg-slate-800 rounded">
            <option>Home</option>
            <option>Vehicle</option>
            <option>Gold</option>
            <option>Personal</option>
        </select><input asp-for="PrincipalAmount" type="number" step="0.01" placeholder="Loan amount"
                        class="w-full p-3 bg-slate-800 rounded" />
        <select asp-for="TenureMonths" class="w-full p-3 bg-slate-800 rounded">
            <option>12</option>
            <option>24</option>
            <option>36</option>
            <option>48</option>
            <option>60</option>
        </select>
        <textarea asp-for="CollateralDetails" placeholder="Collateral / income details"
                  class="w-full p-3 bg-slate-800 rounded">
        </textarea>
        <input asp-for="Document" type="file" class="w-full p-3 bg-slate-800 rounded" />
        <button class="w-full bg-blue-600 p-3 rounded">Submit Application</button>
    </form>
</div>
@model BankingLoanManagement.ViewModels.StaffVm;

<div class="max-w-xl mx-auto bg-slate-900 p-7 rounded-xl">
    <h1 class="text-2xl font-bold mb-5">Create Staff</h1>
    <form method="post" class="space-y-4">
        <input asp-for="Name" placeholder="Name" class="w-full p-3 bg-slate-800 rounded" />
        <input asp-for="Email" placeholder="Email" class="w-full p-3 bg-slate-800 rounded" />
        <input asp-for="Phone" placeholder="Phone" class="w-full p-3 bg-slate-800 rounded" />
        <input asp-for="DateOfBirth" class="w-full p-3 bg-slate-800 rounded" />
        <select asp-for="Role" class="w-full p-3 bg-slate-800 rounded">
            <option>Teller</option>
            <option>LoanOfficer</option>
            <option>Auditor</option>
        </select><button class="w-full bg-blue-600 p-3 rounded">Create</button>
    </form>
    <p class="text-xs text-slate-500 mt-4">Default password = staff member's birth year.</p>
</div>